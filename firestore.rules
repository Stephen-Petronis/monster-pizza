rules_version = '2';
// Firestore rules for the shared "monster-pizza" Firebase project (all arcade games).
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
// Anyone can read the score boards and add a score; nobody can edit or delete one.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{board}/{doc} {
      allow read: if board.matches('ss_g[0-3]') || board == 'wag' || board == 'mi_hockey' || board == 'mi_zomboni';

      allow create: if
        // Super Sullivan: one collection per minigame (ss_g0 .. ss_g3)
        (board.matches('ss_g[0-3]')
          && request.resource.data.keys().hasOnly(['n', 'k', 'd', 't'])
          && request.resource.data.n is string && request.resource.data.n.size() == 3
          && request.resource.data.k is number
          && request.resource.data.d is string && request.resource.data.d.size() <= 12
          && request.resource.data.t is timestamp)
        ||
        // Whack-A-Ghost: initials, score, round reached, time
        (board == 'wag'
          && request.resource.data.keys().hasOnly(['n', 's', 'r', 't'])
          && request.resource.data.keys().hasAll(['n', 's', 'r', 't'])
          && request.resource.data.n is string && request.resource.data.n.matches('[A-Z]{3}')
          && request.resource.data.s is int && request.resource.data.s > 0 && request.resource.data.s <= 9999999
          && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 999
          && request.resource.data.t is timestamp)
        ||
        // Monster Hockey: initials, sort key, score shown ("3-1 EZ" for old wins, "87.3%" for the Zomboni board), time
        ((board == 'mi_hockey' || board == 'mi_zomboni')
          && request.resource.data.keys().hasOnly(['n', 'k', 'd', 't'])
          && request.resource.data.n is string && request.resource.data.n.size() == 3
          && request.resource.data.k is number
          && request.resource.data.d is string && request.resource.data.d.size() <= 12
          && request.resource.data.t is timestamp);

      allow update, delete: if false;
    }

    // Monster Hockey online: a 4-letter room code holds the host's hello (o); the guest writes its reply (a) once.
    // Nothing else is stored, and nobody can list the rooms.
    match /mi_rooms/{code} {
      allow get: if code.matches('[A-HJ-NP-Z]{4}');
      allow create: if code.matches('[A-HJ-NP-Z]{4}')
        && request.resource.data.keys().hasOnly(['o', 't'])
        && request.resource.data.o is string && request.resource.data.o.size() < 20000
        && request.resource.data.t is timestamp;
      allow update: if !('a' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['a'])
        && request.resource.data.a is string && request.resource.data.a.size() < 20000;
      allow list, delete: if false;
    }
  }
}
